# ─────────────────────────────────────────────────────────────────────────────
# Copiar a `.env` y rellenar. `.env` está en .gitignore y NUNCA debe versionarse.
#
# Esto es SOLO para correr el servicio suelto (cd gmail-boletin && docker compose up).
# Dentro del stack completo, estas variables van en el .env de la RAÍZ del repositorio,
# junto a las de Postgres y las del IAM.
# ─────────────────────────────────────────────────────────────────────────────

# --- Credenciales OAuth de Google (obligatorias) ---
# Del cliente OAuth "Aplicación de escritorio" de Google Cloud Console.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
# Obtenido UNA vez con consentimiento interactivo, con alcance gmail.readonly.
# Es el único secreto de larga vida: el access token se deriva de él en cada arranque.
GOOGLE_REFRESH_TOKEN=

# --- Búsqueda y filtros ---
# Sintaxis de búsqueda de Gmail (la misma de la caja de búsqueda de la web).
GMAIL_QUERY=subject:"Boletín SECOM CONAF"
# 0 = todos los que devuelva la búsqueda (paginando). En producción bastan los últimos.
GMAIL_MAX_RESULTADOS=10

# Lista blanca de REMITENTES. Es el filtro de seguridad de esta aplicación: la búsqueda de
# Gmail no autentica nada, así que sin esto cualquiera que escriba a la casilla con ese
# asunto y un enlace publicaría lo que quisiera en la portada. Coma para separar; una
# entrada que empiece con @ vale para todo el dominio (por ejemplo @conaf.cl).
BOLETIN_REMITENTES_PERMITIDOS=noticias@conaf.cl
# Lista blanca de HOSTS del proveedor. Solo se acepta /Documents/Download/<número>.
BOLETIN_HOSTS_PERMITIDOS=mediastation.simbiu.es

# --- Ingesta en Postgres ---
# Se activa por PRESENCIA de DATABASE_HOST (misma convención que el collector). Sin él, la
# aplicación solo LISTA por consola lo que detectó: útil para probar credenciales y filtros
# sin tocar la base.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
# Forzar el modo a mano (true/false). Normalmente no hace falta tocarlo.
# BOLETIN_INGESTA=

# --- Ejecución ---
# 0 = una pasada y salir. >0 = repetir cada N segundos (1800 = cada media hora).
GMAIL_INTERVALO_SEGUNDOS=0
# Franja horaria de revisión, hora de Chile. Vacío = a cualquier hora. El boletín llega
# ~08:00 y SECOM lo mira a las 08:00, así que 7-13 cubre de sobra sin gastar cuota de
# madrugada. Volver a leer el mismo correo es idempotente.
BOLETIN_HORAS_ACTIVAS=
# Zona horaria con la que se muestran e interpretan las fechas.
TZ=America/Santiago
LOG_LEVEL=INFO

# --- Salida por consola (no afecta a la ingesta) ---
GMAIL_INCLUIR_CUERPO=true
# Caracteres de cuerpo a imprimir por correo. 0 = completo.
GMAIL_LARGO_CUERPO=0
