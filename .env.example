# Copiar a .env (producción, apunta al servidor compartido real) o .env.dev
# (desarrollo local, ver docker-compose.dev.yml). Nunca commitear el .env real.

# --- Conexión a PostgreSQL 17 ---
# Producción: host del servidor compartido (ver fastapi-postgresql-conexion.md).
# Desarrollo: DATABASE_HOST=postgres-dev (nombre del servicio en docker-compose.dev.yml).
DATABASE_HOST=<HOST_BD>
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# --- Boletín del servicio contratado: lectura del buzón de Gmail ---
# Las usa el servicio `boletin-correo`, que lee el correo diario de Simbiu MediaStation y
# registra su ENLACE en la tabla boletines_contratados. Sin ellas el servicio no arranca
# (sale con código 2 nombrando las que falten); el resto del stack funciona igual.
#
# El refresh token se obtiene UNA vez, con consentimiento interactivo y alcance
# https://www.googleapis.com/auth/gmail.readonly, en una máquina con navegador. Es el
# ÚNICO secreto de larga vida: el access token dura ~1 h y se deriva de él en cada
# arranque, no se guarda en ninguna parte. Ver gmail-boletin/README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# OPCIONALES (los valores por defecto son los correctos para producción).
# Búsqueda de Gmail. Misma sintaxis que la caja de búsqueda de la web.
GMAIL_QUERY=subject:"Boletín SECOM CONAF"
# Lista blanca de REMITENTES. Es el filtro de seguridad de esta funcionalidad: sin él,
# cualquiera que escriba a la casilla con ese asunto y un enlace publicaría lo que quisiera
# en la portada. Coma para separar; una entrada que empiece con @ vale para todo el dominio.
BOLETIN_REMITENTES_PERMITIDOS=noticias@conaf.cl
# Lista blanca de HOSTS del proveedor. Solo se acepta .../Documents/Download/<número>.
BOLETIN_HOSTS_PERMITIDOS=mediastation.simbiu.es
# Franja horaria de revisión (hora de Chile) y cadencia. Ver docker-compose.yml.
BOLETIN_HORAS_ACTIVAS=7-13
GMAIL_INTERVALO_SEGUNDOS=1800

# --- Puerto interno del servicio "app" (frontend + nginx), detrás del reverse
# proxy ya existente en el servidor (ningún servicio bindea 80/443 en producción).
# El backend no publica puerto propio en producción: nginx (dentro de "app") lo
# alcanza por la red interna de Docker. ---
APP_PORT=8080

# BACKEND_PORT: solo se usa en desarrollo (docker-compose.dev.yml), para poder
# curl/depurar el backend directo desde el host. Sin efecto en producción.
BACKEND_PORT=8000

# --- Ambiente ---
APP_ENV=production

# --- Login: cliente OAuth2 del IAM COIPO (repo COIPO_USUARIOS) ---
# CLIENT_ID / CLIENT_SECRET / IAM_URL / IAM_IP son la MISMA convención que ya usa
# COIPO_APPTEST: si tenés el .env de otra app CONAF, estas cuatro se copian tal cual.
# (También se aceptan como IAM_CLIENT_ID / IAM_CLIENT_SECRET.)
# El client_secret se muestra UNA sola vez al registrar la aplicación en el IAM.
IAM_URL=https://iam.conaf.cl
CLIENT_ID=
CLIENT_SECRET=

# IP INTERNA del IAM: conaf.cl usa DNS de horizonte partido y desde dentro del
# contenedor iam.conaf.cl resuelve a la IP PÚBLICA, inalcanzable desde el servidor de
# aplicaciones (ConnectTimeout de 10 s en cada login). docker-compose.yml la usa en
# extra_hosts. Sigue siendo https con SNI iam.conaf.cl: el certificado valida igual.
IAM_IP=<IP_INTERNA_IAM>

# --- ÚNICA variable nueva obligatoria respecto del .env de otras apps CONAF ---
#
# COIPO_APPTEST no la necesitaba porque armaba la URL de retorno en el navegador
# (window.location.origin). Acá el retorno lo atiende el BACKEND, y el IAM compara la
# redirect_uri por IGUALDAD EXACTA DE STRING, así que tiene que estar escrita y no
# deducida: nginx reenvía el Host que mandó el cliente, y construirla desde ahí sería a
# la vez frágil y adivinar mal daría un "redirect_uri no autorizada" sin pista alguna.
#
# Debe coincidir CARÁCTER POR CARÁCTER con la que esté registrada en el IAM para este
# CLIENT_ID. El backend atiende el retorno en LAS DOS rutas —/auth/callback y
# /api/auth/callback— así que basta con poner acá la que ya esté registrada, sin tener
# que editar el IAM. /auth/callback es la que usa el resto del ecosistema COIPO.
IAM_REDIRECT_URI=https://<HOST_PUBLICO>/auth/callback

# OPCIONAL. Firma la cookie de sesión propia. Si se deja vacío se DERIVA del
# CLIENT_SECRET con PBKDF2-SHA256 y un salt propio (la clave de sesión no es el
# client_secret, y conocer una no da la otra), así que no hace falta llenarlo.
# Definirlo es preferible —claves distintas para propósitos distintos— y tiene
# precedencia. Generar con:  openssl rand -hex 32
# Rotarlo (o rotar el CLIENT_SECRET si se usa el derivado) CIERRA TODAS LAS SESIONES:
# no hacerlo entre 07:00 y 09:00 de Chile.
SESSION_SECRET=

# OPCIONAL. id numérico de esta aplicación en el IAM. Verifica que el token sea de esta
# app; con el patrón BFF es defensa en profundidad (el token lo pide este backend con su
# propio client_id/secret), así que si no lo tenés a mano se puede dejar vacío.
IAM_APP_ID=

# --- Duración de la sesión propia ---
# Ventana DESLIZANTE de inactividad (7 d): quien usó la app en la última semana sigue
# adentro sin volver a pasar por el IAM. ES LO QUE PROTEGE EL BOLETÍN DE LAS 8:00 —
# el IAM solo se consulta en el callback.
SESION_INACTIVIDAD_SEGUNDOS=604800
# Tope absoluto (30 d): obliga a revalidar contra el IAM una vez al mes.
SESION_ABSOLUTA_SEGUNDOS=2592000
# Dispersión aleatoria del tope absoluto (hasta 3 d). Sin esto, todas las sesiones
# creadas el día del despliegue vencen el MISMO día; si ese día el IAM está caído,
# NADIE entra a las 8:00.
SESION_JITTER_SEGUNDOS=259200
SESION_RENOVAR_CADA_SEGUNDOS=3600

# Dejar VACÍO mientras el sitio se sirva por HTTP plano y ponerlo en true recién
# cuando el reverse proxy sirva https. Si se activa antes, el navegador descarta la
# cookie EN SILENCIO y el login entra en un ciclo de reintentos. No se puede deducir
# del request: frontend/nginx.conf fija X-Forwarded-Proto $scheme y dentro del
# contenedor $scheme vale siempre "http".
SESION_HTTPS_ONLY=

# Roles del IAM con permiso de EDICIÓN de conceptos. El nombre del rol es texto libre
# que teclea un admin del IAM, por eso se acepta una lista y se compara en minúsculas.
# Cualquier otro rol —incluido "general", que es lo que el IAM asigna a quien NO tiene
# asignación en esta app— entra en SOLO LECTURA.
ROLES_ADMIN=admin

# OJO: esta variable SOLO tiene efecto si la aplicación está marcada como
# `requires_assignment = false` en el IAM. Si está en true (que es el DEFAULT de toda
# aplicación nueva), el propio IAM rechaza con 403 "No tienes acceso a esta aplicación"
# a quien no tenga rol asignado, y nunca llega a este backend.
#
# Para que cualquier funcionario con cuenta lea el boletín hay que hacer DOS cosas:
#   1. En el IAM: editar la aplicación y desmarcar "requiere asignación".
#   2. Acá: dejar PERMITIR_SIN_ASIGNACION=true.
#
# true  = quien llegue sin rol asignado entra en solo lectura.
# false = no entra (segundo cerrojo, por si la app quedara abierta en el IAM).
PERMITIR_SIN_ASIGNACION=true

# Origen del sitio, para rechazar escrituras cross-site (defensa en profundidad sobre
# SameSite=Lax). Vacío = sin verificación (solo desarrollo).
ORIGENES_PERMITIDOS=https://<HOST_PUBLICO>
